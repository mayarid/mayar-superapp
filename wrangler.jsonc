{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mayar-superapp",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",

  "observability": {
    "enabled": true
  },

  // Non-secret configuration. MAYAR_API_KEY is a secret and is never stored
  // here — set it with: bunx wrangler secret put MAYAR_API_KEY
  "vars": {
    "MAYAR_ENV": "production",
    "APP_URL": "http://localhost:3000"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mayar-superapp",
      "database_id": "6ed6a3c1-7e19-4a2c-8c9c-ae4d3dfb7a92",
      "migrations_dir": "db/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "mayar-superapp-assets"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "d9fe6d6fba5b40ef8a3133c56e27369d"
    }
  ],

  "durable_objects": {
    "bindings": [
      // Single global instance. Owns the 50 req/min token bucket for every
      // Mayar call, and runs the reconciler alarm while orders are pending.
      {
        "name": "MAYAR_GATE",
        "class_name": "MayarGate"
      },
      // One instance per client IP. Caps checkout creation.
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MayarGate", "RateLimiter"]
    }
  ]
}
